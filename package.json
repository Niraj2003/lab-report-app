{
  "name": "pitrubhakt-lab-report",
  "version": "1.0.0",
  "description": "Desktop Electron application converted from the supplied laboratory report web application.",
  "main": "main.js",
  "author": "Niraj Amrutkar",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "check": "node --check main.js && node --check renderer.js"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nirajdev.labreport",
    "productName": "Pitrubhakt-Lab-Report",
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "main.js"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
