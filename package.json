{
  "name": "lab-report-electron",
  "version": "1.0.0",
  "description": "Desktop Electron application converted from the supplied laboratory report web application.",
  "main": "main.js",
  "author": "Niraj Amrutkar",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nirajdev.labreport",
    "productName": "Lab Report",
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "main.js",
      "preload.js",
      "node_modules/html2canvas/dist/html2canvas.min.js",
      "node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2",
      "node_modules/@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2",
      "node_modules/@fontsource/source-serif-4/files/source-serif-4-latin-600-normal.woff2",
      "node_modules/@fontsource/source-serif-4/files/source-serif-4-latin-700-normal.woff2",
      "node_modules/@fontsource/cinzel/files/cinzel-latin-700-normal.woff2",
      "node_modules/@fontsource/cinzel/files/cinzel-latin-900-normal.woff2"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "html2canvas": "^1.4.1"
  }
}
